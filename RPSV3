if stats["losses"]==0:
    kdr="N/A"
else:
    kdr=stats["wins"]/stats["losses"]
    kdr=round(kdr,2)
matches=stats["choices"]["rock"]+stats["choices"]["paper"]+stats["choices"]["scissors"]
